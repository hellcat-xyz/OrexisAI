+        } finally {
+            if (state.controller === controller) state.controller = null;
+            state.loading = false;
+            setLoading(false);
+            schedulePoll();
+        }
+    }
+
+    function renderDashboard(dashboard) {
+        const metrics = dashboard?.executive?.metrics || [];
+        const hasOrders = Number(metricByKey('orders', dashboard)?.value || 0) > 0;
+        root.innerHTML = `
