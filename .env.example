PORT=3000
NODE_ENV=development

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/outcomeai

# Set to true when your hosted PostgreSQL provider requires TLS.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# bcrypt work factor. Allowed range: 10-14.
BCRYPT_ROUNDS=12

# Only trust X-Forwarded-For when running behind a trusted reverse proxy.
TRUST_PROXY=false

# hCaptcha protects email/password login and account creation.
# The site key is public and rendered only on the auth pages. Keep the secret server-side.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
HCAPTCHA_TIMEOUT_MS=8000

# Razorpay Standard Checkout credentials. Use test keys while developing.
# Test key IDs start with rzp_test_. Keep all secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Create this separately in Razorpay Dashboard -> Account & Settings -> Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# PayPal REST app credentials. Use sandbox until checkout is verified.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Google Gemini API for the database-backed AI Agent chat.
# Create a key in Google AI Studio and keep it server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated fallback models used only when the selected model is unavailable.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_HISTORY_MESSAGES=40
# adaptive chooses minimal/low/medium/high from request complexity. You can force one level.
GEMINI_THINKING_LEVEL=adaptive

# Public URL used in OAuth callbacks and password-reset email links.
APP_BASE_URL=http://localhost:3000

# Password-reset email delivery via Resend's HTTPS API.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=OrexisAI <no-reply@example.com>
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=10000
PASSWORD_RESET_TOKEN_MINUTES=30

# Central prompt/input limits. Character counting uses Unicode grapheme clusters.
PROMPT_MAX_CHARACTERS=131072
PROMPT_MAX_TOKENS=32768
PROMPT_WARNING_RATIO=0.85
# Optional per-model overrides. The effective limit is the lower of the global
# limit and the selected model override. Example:
# AI_MODEL_PROMPT_LIMITS_JSON={"gemini-2.5-flash":{"maxCharacters":131072,"maxTokens":32768}}
AI_MODEL_PROMPT_LIMITS_JSON=

# Optional review-provider write connector. OrexisAI saves and approves drafts
# without this. Sending is enabled only when this server-side endpoint exists.
REVIEW_RESPONSE_API_URL=
REVIEW_RESPONSE_API_TOKEN=
REVIEW_RESPONSE_TIMEOUT_MS=10000

# Weekly Marketing live-data and creative providers
# Gemini text uses GEMINI_API_KEY above; image generation uses the same server-side key.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_TIMEOUT_MS=90000
MARKETING_SOURCE_TIMEOUT_MS=12000
MARKETING_SOURCE_RETRIES=2

# Google Places API (New) for Business Profile details and public reviews.
GOOGLE_PLACES_API_KEY=

# Google Trends API is currently access-controlled. Configure your approved
# Google Trends endpoint, or an internal connector that returns real provider data.
GOOGLE_TRENDS_API_URL=
GOOGLE_TRENDS_API_TOKEN=

# Optional real keyword/social trend provider connectors. Each receives a JSON
# POST and must return JSON. Tokens are sent as Authorization: Bearer <token>.
KEYWORD_TRENDS_API_URL=
KEYWORD_TRENDS_API_TOKEN=
SOCIAL_TRENDS_API_URL=
SOCIAL_TRENDS_API_TOKEN=

# Live news, local events, and weather.
NEWS_API_KEY=
NEWS_API_LANGUAGE=en
TICKETMASTER_API_KEY=
OPENWEATHER_API_KEY=
OPENWEATHER_UNITS=metric
SEASONAL_EVENTS_API_URL=
SEASONAL_EVENTS_API_TOKEN=
GEMINI_RETRIES=2

# Marketing workspace cache, realtime scheduler, and background worker controls.
# Scheduled executions are claimed transactionally from PostgreSQL so multiple
# application instances do not run the same due schedule concurrently.
MARKETING_DASHBOARD_CACHE_SECONDS=30
MARKETING_SCHEDULER_ENABLED=true
MARKETING_SCHEDULER_POLL_MS=60000
MARKETING_SCHEDULER_BATCH_SIZE=5
