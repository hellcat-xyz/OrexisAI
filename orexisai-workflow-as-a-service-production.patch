+            (SELECT COUNT(*) FROM business_reviews
+             WHERE business_id = $1 AND response_status IN ('unanswered', 'draft'))::INTEGER AS followups_due,
+            (SELECT COUNT(*) FROM customer_orders WHERE order_count >= 2)::INTEGER AS repeat_customers,
