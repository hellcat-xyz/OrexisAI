+    function initializeWorkspaceRobot() {
+        if (!workspaceRobotLayer) return null;
+        const dock = createAssistantRobot('idle', false, {
+            className: 'orexis-assistant-robot orexis-workspace-robot'
+        });
+        workspaceRobotLayer.replaceChildren(dock);
+        return dock;
+    }
+
+    function setWorkspaceRobotState(state) {
+        if (!workspaceRobotDock) return;
+        const activeTimer = robotLifecycleTimers.get(workspaceRobotDock);
+        if (activeTimer) window.clearTimeout(activeTimer);
+        robotLifecycleTimers.delete(workspaceRobotDock);
+        applyAssistantRobotState(workspaceRobotDock, state);
+
+        if (state === 'celebrating') {
+            const celebrationTimer = window.setTimeout(() => {
+                if (workspaceRobotDock.isConnected) applyAssistantRobotState(workspaceRobotDock, 'idle');
+                robotLifecycleTimers.delete(workspaceRobotDock);
+            }, 1180);
+            robotLifecycleTimers.set(workspaceRobotDock, celebrationTimer);
+            return;
+        }
+
+        if (state === 'error') {
+            const recoveryTimer = window.setTimeout(() => {
+                if (workspaceRobotDock.isConnected) applyAssistantRobotState(workspaceRobotDock, 'idle');
+                robotLifecycleTimers.delete(workspaceRobotDock);
+            }, 1200);
+            robotLifecycleTimers.set(workspaceRobotDock, recoveryTimer);
+        }
+    }
+
+    function syncWorkspaceRobotVoiceButton() {
+        const state = String(voiceStateButton?.dataset.state || '').trim();
+        if (state) handleWorkspaceRobotVoiceState({ detail: { state } });
+    }
+
+    function handleWorkspaceRobotVoiceState(event) {
+        const state = String(event?.detail?.state || '').toLowerCase();
+        if (!state || !workspaceRobotDock) return;
+        if (state === 'listening') {
+            setWorkspaceRobotState('listening');
+            return;
+        }
+        if (state === 'processing' || state === 'thinking') {
+            setWorkspaceRobotState('thinking');
+            return;
+        }
+        if (state === 'speaking') {
+            setWorkspaceRobotState('speaking');
+            return;
+        }
+        if (state === 'finished' || state === 'complete' || state === 'completed') {
+            setWorkspaceRobotState('celebrating');
+            return;
+        }
+        if (state === 'error' || state === 'failed') {
+            setWorkspaceRobotState('error');
+            return;
+        }
+        if (state === 'idle' || state === 'stopped') {
+            setWorkspaceRobotState('idle');
+        }
+    }
+
