+function postCard(p){return `<article class="wc-card" data-post="${p.id}"><div class="wc-post-head">${avatar(p.username,p.avatar_url)}<div><b>${esc(p.username)}</b><div class="wc-meta">${esc(p.profession||p.headline||'Professional')} · ${fmtDate(p.created_at)}</div></div><span class="wc-status" style="margin-left:auto">${esc(p.category.replaceAll('_',' '))}</span></div><div class="wc-post-body">${esc(p.body)}</div><div class="wc-meta">${p.like_count} likes · ${p.comment_count} comments</div><div class="wc-actions"><button class="wc-btn secondary small" data-like="${p.id}" data-liked="${p.liked?'1':'0'}"><i class="fa-${p.liked?'solid':'regular'} fa-thumbs-up"></i> ${p.liked?'Liked':'Like'}</button><button class="wc-btn secondary small" data-comment="${p.id}"><i class="fa-regular fa-comment"></i> Comment</button><button class="wc-btn secondary small" data-profile="${p.author_user_id}">View profile</button>${Number(p.author_user_id)===userId?`<button class="wc-btn danger small" data-delete-post="${p.id}">Delete</button>`:''}</div></article>`}
