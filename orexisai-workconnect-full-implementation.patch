+function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
+function fmtDate(v){if(!v)return'';return new Intl.DateTimeFormat(undefined,{dateStyle:'medium'}).format(new Date(v));}
+function initials(v){return String(v||'U').trim().split(/\s+/).slice(0,2).map(x=>x[0]).join('').toUpperCase();}
+function money(minor,c='INR'){if(minor==null)return'';try{return new Intl.NumberFormat(undefined,{style:'currency',currency:c||'INR',maximumFractionDigits:0}).format(Number(minor)/100)}catch{return `${c} ${(Number(minor)/100).toFixed(0)}`}}
+async function uploadFile(file,purpose){const r=await fetch(`/api/workconnect/media?purpose=${encodeURIComponent(purpose)}&name=${encodeURIComponent(file.name)}`,{method:'POST',headers:{'Content-Type':file.type},body:file});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Upload failed.');return d.media;}
+async function api(url,opts={}){const r=await fetch(url,{...opts,headers:{...(opts.body&&!opts.headers?.['Content-Type']?{'Content-Type':'application/json'}:{}),...(opts.headers||{})}});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||`Request failed (${r.status})`);return data;}
+function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.remove('hidden');clearTimeout(toast.t);toast.t=setTimeout(()=>t.classList.add('hidden'),3200)}
