+}
+async function renderTab(tab){state.tab=tab;$$('#wcNav [data-tab]').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));$('.wc-sidebar').classList.remove('open');loading();try{if(tab==='feed')await renderFeed();if(tab==='discover')await renderDiscover();if(tab==='jobs')await renderJobs();if(tab==='profile')await renderProfile();if(tab==='messages')await renderMessages();if(tab==='dashboard')await renderDashboard()}catch(e){$('#wcContent').innerHTML=empty('fa-solid fa-triangle-exclamation','Could not load this section',e.message)}}
+
+async function renderFeed(){const d=await api(`/api/workconnect/posts?scope=${state.feedScope}`);const p=state.bootstrap.profile;$('#wcContent').innerHTML=`<div class="wc-grid"><div><div class="wc-hero"><h1>Professional Feed</h1><p>Share real work, projects, certifications and opportunities with the OrexisAI community.</p></div><div class="wc-card wc-composer"><div class="wc-person-head">${avatar(p.username,p.avatar_url)}<div><b>${esc(p.username)}</b><div class="wc-meta">${esc(p.profession||'Complete your professional profile')}</div></div></div><div class="wc-field" style="margin-top:14px"><textarea id="postBody" placeholder="Share a professional update…"></textarea></div><div class="wc-field"><label>Photo / video / certificate (optional)</label><input id="postMedia" type="file" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,application/pdf"></div><label class="wc-meta"><input id="postPermission" type="checkbox"> I have permission to publish this media and it does not expose private customer information.</label><div class="wc-actions"><select id="postCategory" class="wc-btn secondary"><option value="general">General update</option><option value="completed_work">Completed work</option><option value="project_update">Project update</option><option value="certification">Certification</option><option value="achievement">Achievement</option><option value="job_opportunity">Job opportunity</option><option value="available_for_work">Available for work</option></select><button class="wc-btn" id="publishPost">Publish</button></div></div><div class="wc-actions"><button class="wc-btn ${state.feedScope==='public'?'':'secondary'}" data-feed-scope="public">Discover</button><button class="wc-btn ${state.feedScope==='following'?'':'secondary'}" data-feed-scope="following">Following</button></div><div id="feedList">${d.posts.length?d.posts.map(postCard).join(''):empty('fa-regular fa-newspaper','No posts yet','Professional updates will appear here when users publish them.')}</div></div><aside><div class="wc-card"><h3>Your WorkConnect identity</h3><p class="wc-muted">${esc(p.headline||'Add a headline so people understand what you do.')}</p><div class="wc-stats"><div class="wc-stat"><b>${p.follower_count||0}</b><span class="wc-meta">Followers</span></div><div class="wc-stat"><b>${p.review_count||0}</b><span class="wc-meta">Reviews</span></div><div class="wc-stat"><b>${p.rating||'—'}</b><span class="wc-meta">Rating</span></div></div><div class="wc-actions"><button class="wc-btn secondary" data-go="profile">Edit profile</button></div></div></aside></div>`;
+  $('#publishPost').onclick=async()=>{const body=$('#postBody').value.trim();if(!body)return toast('Write something before publishing.');try{const f=$('#postMedia').files[0];let mediaIds=[];if(f){if(!$('#postPermission').checked)return toast('Confirm media publication permission first.');const m=await uploadFile(f,'post');mediaIds=[m.id]}await api('/api/workconnect/posts',{method:'POST',body:JSON.stringify({body,category:$('#postCategory').value,mediaIds,permissionConfirmed:!!f})});toast('Post published.');renderFeed()}catch(e){toast(e.message)}};
+  $$('[data-feed-scope]').forEach(b=>b.onclick=()=>{state.feedScope=b.dataset.feedScope;renderFeed()});$$('[data-go="profile"]').forEach(b=>b.onclick=()=>renderTab('profile'));bindPostActions();
