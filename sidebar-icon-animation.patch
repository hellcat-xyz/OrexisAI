+/* Premium sidebar icon and active-state motion */
+.sidebar .nav-menu {
+    position: relative;
+    isolation: isolate;
+    --nav-active-x: 0px;
+    --nav-active-y: 0px;
+    --nav-active-width: 100%;
+    --nav-active-height: 44px;
+    --nav-indicator-x: 0px;
+    --nav-indicator-y: 12px;
+    --nav-indicator-height: 20px;
+}
+
+.sidebar .nav-item {
+    position: relative;
+    z-index: 2;
+    overflow: visible;
+    isolation: isolate;
+    transform: translate3d(0, 0, 0);
+    transition:
+        color 160ms cubic-bezier(.2, .8, .2, 1),
+        background-color 160ms cubic-bezier(.2, .8, .2, 1),
+        transform 180ms cubic-bezier(.2, .8, .2, 1);
+    -webkit-tap-highlight-color: transparent;
+}
+
+.sidebar .nav-item::after {
+    content: '';
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    border-radius: inherit;
