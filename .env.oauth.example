# Add these values to your existing .env file.
# Public origin used to build exact OAuth callback URLs. Do not add a path.
APP_BASE_URL=http://localhost:3000

# Google OAuth 2.0 Web application credentials.
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth2 application credentials.
# Redirect URI: http://localhost:3000/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
